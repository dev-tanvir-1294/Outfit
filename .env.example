# Copy this file to `.env.local` and fill in your values.

# WordPress/WooCommerce site root URL (no trailing slash)
WOOCOMMERCE_URL=https://your-store.com

# WooCommerce REST API keys (WooCommerce → Settings → Advanced → REST API → Add key, Read/Write)
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Currency code (e.g. USD, EUR, BDT)
WOOCOMMERCE_CURRENCY=USD

# PayStation hosted checkout (server-only credentials; sandbox is the default)
PAYSTATION_MERCHANT_ID=
PAYSTATION_PASSWORD=
PAYSTATION_MODE=sandbox
APP_URL=http://localhost:3000

# --- Account features (login + order history) ---
# Install the "JWT Authentication for WP REST API" plugin on WordPress,
# then set the JWT secret and enable CORS as described in the README.
WORDPRESS_URL=https://your-store.com
WORDPRESS_JWT_PATH=/wp-json/jwt-auth/v1/token
